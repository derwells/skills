#!/usr/bin/env bash
# claudex — Claude Code rerouted to Xiaomi MiMo. Tokens come off the MiMo
# plan, not the Anthropic quota. Disposable research harness; see the claudex
# skill's SKILL.md. Install together with claudex-mimo-search.
#
# Backend: token plan (default) or pay-as-you-go.
#   plan : MIMO_API_KEY   or ~/.claude/mimo_token        (tp-... / ttp-...)
#   paygo: MIMO_PAYGO_KEY or ~/.claude/mimo_paygo_token  (sk-...)
#   switch per run: claudex --paygo ...   persistent: echo paygo > ~/.claude/claudex_backend
set -euo pipefail

PLAN_URL="${CLAUDEX_PLAN_URL:-https://token-plan-sgp.xiaomimimo.com/anthropic}"   # token-plan clusters are regional: sgp, ams, cn
PAYGO_URL="https://api.xiaomimimo.com/anthropic"
PRO="mimo-v2.6-pro"
FLASH="mimo-v2.6-flash"

backend="plan"
[ -f "$HOME/.claude/claudex_backend" ] && backend="$(tr -d '[:space:]' < "$HOME/.claude/claudex_backend")"
args=()
for a in "$@"; do
  case "$a" in
    --paygo) backend="paygo" ;;
    --plan)  backend="plan" ;;
    *) args+=("$a") ;;
  esac
done

read_key() { [ -f "$1" ] && tr -d '[:space:]' < "$1" || true; }
plan_key="${MIMO_API_KEY:-$(read_key "$HOME/.claude/mimo_token")}"
paygo_key="${MIMO_PAYGO_KEY:-$(read_key "$HOME/.claude/mimo_paygo_token")}"

if [ "$backend" = "plan" ] && [ -z "$plan_key" ] && [ -n "$paygo_key" ]; then
  backend="paygo"   # no plan token at all: fall back to PAYG
fi
case "$backend" in
  plan)
    [ -n "$plan_key" ] || { echo "claudex: no MiMo token. Set MIMO_API_KEY or write it to ~/.claude/mimo_token" >&2; exit 2; }
    export ANTHROPIC_BASE_URL="$PLAN_URL" ANTHROPIC_AUTH_TOKEN="$plan_key" ;;
  paygo)
    [ -n "$paygo_key" ] || { echo "claudex: no MiMo pay-as-you-go key. Set MIMO_PAYGO_KEY or write it to ~/.claude/mimo_paygo_token" >&2; exit 2; }
    export ANTHROPIC_BASE_URL="$PAYGO_URL" ANTHROPIC_AUTH_TOKEN="$paygo_key" ;;
  *) echo "claudex: unknown backend '$backend' in ~/.claude/claudex_backend (plan|paygo)" >&2; exit 2 ;;
esac

# Never let the Anthropic login leak through, and never let this session be
# mistaken for the main one.
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
export CLAUDE_CODE_USE_BEDROCK=0 CLAUDE_CODE_USE_VERTEX=0

# Built-in agents can select the Opus tier even when the main session uses
# Flash. Keep every tier on Flash unless this run explicitly selects Pro.
selected_model="${CLAUDEX_MODEL:-$FLASH}"
next_is_model=false
for a in "${args[@]}"; do
  if "$next_is_model"; then
    selected_model="$a"
    next_is_model=false
    continue
  fi
  case "$a" in
    --model) next_is_model=true ;;
    --model=*) selected_model="${a#--model=}" ;;
  esac
done
tier="$FLASH"
case "$selected_model" in
  opus|fable|"$PRO"|"$PRO[1m]") tier="$PRO" ;;
esac
export ANTHROPIC_MODEL="${CLAUDEX_MODEL:-$FLASH}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$tier"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$tier"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$FLASH"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$FLASH"
export ANTHROPIC_SMALL_FAST_MODEL="$FLASH"
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDEX_SUBAGENT_MODEL:-$tier}"
export API_TIMEOUT_MS="${API_TIMEOUT_MS:-3000000}"
# Both MiMo V2.6 models have a 1M window. Claude Code otherwise assumes 200K
# for their unknown IDs; this keeps proactive compaction at the real limit.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-1000000}"
# MiMo ignores prompt-cache and thinking-budget fields; nothing to set for those.

# Some agent runners launch this file as the Claude executable and pass their
# own argv; the CLI path adds the extras. Keep both identical apart from argv.
# Web search: Claude Code's built-in WebSearch is an Anthropic server tool and
# MiMo's Anthropic endpoint returns only query echoes, so it stays denied (deny
# beats any caller allowlist). MiMo search runs only over its OpenAI protocol;
# claudex-mimo-search bridges it as the MCP tool mcp__mimo__web_search. An
# extra --mcp-config adds to the caller's servers.
# CLAUDEX_SEARCH=0 leaves it out.
export CLAUDEX_PLAN_URL="$PLAN_URL"
# Default: claudex-mimo-search on PATH, else next to this script.
search_bin="${CLAUDEX_SEARCH_BIN:-$(command -v claudex-mimo-search || true)}"
[ -n "$search_bin" ] || search_bin="$(dirname "$(readlink -f "$0")")/claudex-mimo-search"
extra=()
if [ "${CLAUDEX_SEARCH:-1}" != 0 ] && [ -x "$search_bin" ]; then
  extra+=(--mcp-config "{\"mcpServers\":{\"mimo\":{\"type\":\"stdio\",\"command\":\"$search_bin\",\"args\":[]}}}"
          --allowedTools mcp__mimo__web_search)
fi
exec "${CLAUDEX_CLAUDE_BIN:-claude}" "${args[@]}" "${extra[@]}" --disallowedTools WebSearch
